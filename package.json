{
  "name": "tailbase-theme-settings",
  "version": "1.3.0",
  "description": "Theme settings page for the Tailbase theme, built with React.",
  "author": "MM",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "theme",
    "settings",
    "react",
    "hook-form"
  ],
  "homepage": "https://github.com/RichForever/tailbase-theme-settings",
  "repository": {
    "type": "git",
    "url": "https://github.com/RichForever/tailbase-theme-settings"
  },
  "bugs": {
    "url": "https://github.com/RichForever/tailbase-theme-settings/issues"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@codemirror/lang-html": "^6.4.12",
    "@uiw/react-codemirror": "^4.25.12",
    "react-hook-form": "^7.90.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@release-it/bumper": "^8.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@wordpress/prettier-config": "^4.57.0",
    "@wordpress/scripts": "^36.1.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint-import-resolver-webpack": "^0.13.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lucide-react": "^1.58.0",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1"
  },
  "scripts": {
    "build": "wp-scripts build",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:css:fix": "wp-scripts lint-style --fix",
    "lint:js": "wp-scripts lint-js",
    "lint:js:fix": "wp-scripts lint-js --fix",
    "lint:md:docs": "wp-scripts lint-md-docs",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip",
    "start": "wp-scripts start",
    "prepare": "husky",
    "pretty": "npx prettier . --write",
    "release": "release-it",
    "commit": "cz"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "wp-scripts lint-js --no-warn-ignored",
    "*.{css,scss}": "wp-scripts lint-style --allow-empty-input",
    "package.json": "wp-scripts lint-pkg-json"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}"
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/bumper": {
        "in": "tailbase-theme-settings.php",
        "out": "tailbase-theme-settings.php",
        "regex": "Version:\\s*([\\d.]+)"
      },
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "🚀 Features",
              "hidden": false
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes",
              "hidden": false
            },
            {
              "type": "docs",
              "section": "📝 Documentation",
              "hidden": false
            },
            {
              "type": "style",
              "section": "💄 Code Style",
              "hidden": false
            },
            {
              "type": "refactor",
              "section": "♻️ Refactoring",
              "hidden": false
            },
            {
              "type": "perf",
              "section": "⚡ Performance Improvements",
              "hidden": false
            },
            {
              "type": "test",
              "section": "🧪 Tests",
              "hidden": false
            },
            {
              "type": "build",
              "section": "🏗 Build System",
              "hidden": false
            },
            {
              "type": "ci",
              "section": "🔧 Continuous Integration",
              "hidden": false
            },
            {
              "type": "chore",
              "section": "📦 Miscellaneous",
              "hidden": false
            },
            {
              "type": "revert",
              "section": "⏪ Reversions",
              "hidden": false
            }
          ]
        }
      }
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
